{
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|clear|compact",
      "hooks": [{"type":"command","command":"./bin/CodexQuickOKHook","timeout":2}]
    }],
    "UserPromptSubmit": [{
      "hooks": [{"type":"command","command":"./bin/CodexQuickOKHook","timeout":2}]
    }],
    "Stop": [{
      "hooks": [{"type":"command","command":"./bin/CodexQuickOKHook","timeout":2}]
    }]
  }
}
